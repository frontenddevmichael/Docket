# =============================================================
# Docket environment configuration
#
# Two files, two consumers:
#
# 1. ROOT `.env.local` — read by the Express server (copied from this file).
# 2. `client/.env`    — read by Vite at build time (only the VITE_ keys; they
#                       are baked into the client bundle).
#
# Copy this file to BOTH locations, then fill in the values:
#   cp .env.example .env.local
#   cp .env.example client/.env
# =============================================================

# ── Shared (used by both server and client) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Server only (root .env.local) ────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
OPENROUTER_API_KEY=sk-or-v1-...
PORT=3001

# Public URL of the deployed app — used in email links (invitations, assignments,
# issue-log drafts). Must NOT be localhost in production.
CLIENT_ORIGIN=http://localhost:5175

# ── Optional integrations ────────────────────────────────────
# Transactional email (invite / assign / reject / issue drafts). Without it,
# emails are logged instead of sent.
RESEND_API_KEY=re_...
EMAIL_FROM=Docket <noreply@your-domain.com>

# Import integrations (Figma links, GitHub PRs)
FIGMA_ACCESS_TOKEN=your-figma-token
GITHUB_TOKEN=your-github-token

# Client-side analytics (baked in via client/.env)
VITE_POSTHOG_KEY=phc_...

# ── Optional: Custom SMTP for Supabase Auth emails (configure in Supabase dashboard)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
