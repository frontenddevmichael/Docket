# Shared (.env.local — loaded by both client and server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
OPENROUTER_API_KEY=sk-or-v1-...
FIGMA_ACCESS_TOKEN=your-figma-token
GITHUB_TOKEN=your-github-token
PORT=3001
RESEND_API_KEY=re_...
EMAIL_FROM=Docket <noreply@your-domain.com>
CLIENT_ORIGIN=http://localhost:5175

# Optional: Custom SMTP for Supabase Auth emails (configure in Supabase dashboard)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
